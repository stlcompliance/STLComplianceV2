# syntax=docker/dockerfile:1
# Production multi-stage Dockerfile for Vite SPA frontends on Cloud Run
FROM node:22-bookworm-slim AS build
WORKDIR /repo

ARG FRONTEND_APP=suite-frontend
COPY apps/${FRONTEND_APP}/package.json apps/${FRONTEND_APP}/package-lock.json ./apps/${FRONTEND_APP}/
COPY packages/shared-ui/ ./packages/shared-ui/
WORKDIR /repo/apps/${FRONTEND_APP}
RUN npm ci
RUN ln -s /repo/apps/${FRONTEND_APP}/node_modules /repo/packages/shared-ui/node_modules || true
COPY apps/${FRONTEND_APP}/ ./
RUN npm run build

FROM nginx:alpine
ARG FRONTEND_APP=suite-frontend
COPY --from=build /repo/apps/${FRONTEND_APP}/dist /usr/share/nginx/html

# Replace default Nginx configuration to support SPA routing & PORT environment variable
RUN echo 'server { \
    listen 8080; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
